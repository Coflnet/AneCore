<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Coflnet.Core" Version="0.7.0" />
    <PackageReference Include="HtmlAgilityPack" Version="1.12.4" />
    <PackageReference Include="MessagePack" Version="3.1.7" />
    <PackageReference Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageReference Include="OpenSearch.Client" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="Categories/UnifiedCategories.json" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="Categories/CategoryScope.json" LogicalName="Coflnet.Ane.Categories.CategoryScope.json" />
    <EmbeddedResource Include="KnownProducts/Seed/*.json" />
  </ItemGroup>

  <ItemGroup>
    <!-- AneCore.Tests and tools/ are separate, non-shipped projects living inside this directory for
         convenience; the SDK's default recursive globs would otherwise pull their .cs/content files
         into this library and its NuGet-consuming dependants (AneNotifier/AneApi reference this project
         directly, not a package, but keeping the library's own compile unit clean still matters). -->
    <Compile Remove="AneCore.Tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
    <Content Remove="AneCore.Tests/**/*" />
    <Content Remove="tools/**/*" />
    <None Remove="AneCore.Tests/**/*" />
    <None Remove="tools/**/*" />
    <EmbeddedResource Remove="AneCore.Tests/**/*" />
    <EmbeddedResource Remove="tools/**/*" />
  </ItemGroup>

</Project>
